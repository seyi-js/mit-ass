DATABASE_URL=postgresql://maintenance:maintenance@localhost:5432/maintenance
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Required only when creating the first administrator with npm run db:setup.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-password
# API integration tests reset only the dedicated test database.
TEST_DATABASE_URL=postgresql://maintenance:maintenance@localhost:5432/maintenance_test
